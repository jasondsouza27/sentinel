{
  "manifest_version": 3,
  "name": "Sentinel Safety Assistant",
  "version": "0.1.0",
  "description": "User-initiated checks of selected text and links with the local Sentinel app.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Check with Sentinel" }
}
