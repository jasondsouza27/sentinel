{
  "schema": "url-ml-config-v2",
  "sources": {
    "phreshphish": {
      "source_id": "phreshphish",
      "repository": "phreshphish/phreshphish",
      "revision": "eabec4b7a66324b79cc8a0ad856d1731dc26fe1a",
      "label_map": {
        "benign": 0,
        "phish": 1
      },
      "date_semantics": {
        "meaning": "unverified source date",
        "evidence_ref": "source-date semantics require an acquisition audit",
        "timezone": null,
        "authenticated": false
      }
    },
    "iscx": {
      "source_id": "iscx-url2016",
      "revision": "local-official",
      "source_url": "https://www.unb.ca/cic/datasets/url-2016.html",
      "label_map": {
        "benign": 0,
        "phishing": 1
      },
      "date_semantics": {
        "meaning": "unverified source date",
        "evidence_ref": "source-date semantics require an acquisition audit",
        "timezone": null,
        "authenticated": false
      }
    }
  },
  "parser": {
    "max_url_chars": 2048,
    "psl_sha256": "e0fe072d26b0536525badea237953ff451c9f8e64c9d02c6daa81a4491d2fc66"
  },
  "projection": {
    "allow_hosts": [
      "huggingface.co",
      "us.aws.cdn.hf.co"
    ],
    "timeout_seconds": 30,
    "max_retries": 3,
    "max_footer_bytes": 2097152,
    "max_range_bytes": 33554432,
    "max_response_bytes": 2147483648,
    "batch_rows": 4096,
    "max_inventory_bytes": 2097152,
    "max_card_bytes": 262144,
    "thrift_string_limit": 2097152,
    "thrift_container_limit": 100000
  },
  "split": {
    "seed": 42,
    "fractions": {
      "train": 0.8,
      "validation": 0.1,
      "calibration": 0.1
    },
    "development_max_rows": 200000
  },
  "support": {
    "train_min_rows_per_class": 1000,
    "train_min_groups_per_class": 100,
    "other_min_rows_per_class": 100,
    "other_min_groups_per_class": 30,
    "benign_min_non_root_path": 100,
    "benign_min_non_www_host": 100,
    "benign_min_query": 30
  },
  "training": {
    "schema": "url-ml-config-v1",
    "seed": 42,
    "max_fpr": 0.05,
    "native_threads": 4,
    "max_peak_bytes": 8589934592,
    "pilot_max_rows": 2000,
    "char_tfidf": {
      "max_features": 50000,
      "ngram_range": [
        3,
        5
      ],
      "C": [
        0.1,
        1,
        10
      ],
      "class_weight": [
        null,
        "balanced"
      ]
    },
    "lexical_hgb": {
      "max_depth": [
        3,
        5
      ],
      "learning_rate": [
        0.05,
        0.1
      ],
      "max_iter": 200
    },
    "calibration": {
      "min_rows": 100,
      "min_per_class": 20,
      "epsilon": 1e-06
    },
    "bootstrap_replicates": 1000,
    "sensitivity_budgets": [
      0.05,
      0.01
    ]
  }
}
